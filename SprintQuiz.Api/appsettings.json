{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=SprintQuizDb;Username=postgres;Password=your_password_here"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "SecretKey": "your_super_secret_key_here_minimum_32_characters",
    "Issuer": "SprintQuiz.Api",
    "Audience": "SprintQuiz.Client",
    "ExpirationInMinutes": 60
  },
  "ApplicationSettings": {
    "DefaultQuizPassingScore": 0.5,
    "MaxQuestionsPerQuiz": 100,
    "DefaultQuestionsPerLevel": {
      "Cours": 15,
      "Module": 40,
      "Sprint": 60
    }
  }
}

